<div class="container">

  <div class="page-header">
  <%= link_to "Activity Log",
            transporter_activities_path,
            class: "button" %>
    <div>
      <p class="location-label">SPD TRANSPORT</p>
      <h1>Transporter Dashboard</h1>
      <p>Today's active transport requests.</p>
    </div>
  </div>

  <% if notice %>
    <div class="notice">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div class="error">
      <%= alert %>
    </div>
  <% end %>

<div class="card">

  <h2>Locations</h2>

  <p>Select the clinic or department you are currently visiting.</p>

  <div class="clinic-button-list">

    <% @locations.each do |location| %>

      <%= link_to location.name,
                  transporter_location_path(location),
                  class: "button button-primary" %>

    <% end %>

  </div>

</div>

    <% if @requests.any? %>

      <% @requests.each do |request| %>

        <div class="transporter-request">

          <div>
            <h2><%= request.location.name %></h2>

            <p>
              Requested by:
              <strong><%= request.requested_by_name %></strong>
            </p>

            <p class="request-time">
              <%= request.requested_at.strftime("%I:%M %p") %>
            </p>
          </div>

          <div class="transporter-request-status">

            <% if request.status == "requested" %>

              <span class="status status-requested">
                Requested
              </span>

              <%= button_to "Accept",
                    transporter_accept_request_path(request.id),
                    method: :post,
                    class: "button button-primary" %>

              <% elsif request.status == "accepted" %>

                <span class="status status-accepted">
                  Accepted
                </span>

                <%= button_to "Start Transport",
                      transporter_start_transport_path(request.id),
                      method: :post,
                      class: "button button-primary" %>

          <% elsif request.status == "in_transit" %>

            <span class="status status-in-transit">
              In-Transit
            </span>

            <%= button_to "Mark Completed",
                  transporter_complete_request_path(request.id),
                  method: :post,
                  class: "button button-primary" %>

          <% elsif request.status == "completed" %>

            <span class="status status-completed">
              Completed
            </span>

          <% end %>

          </div>

        </div>

      <% end %>

    <% else %>

      <div class="empty-state">
        <h2>No active requests</h2>
        <p>There are currently no transport requests waiting for SPD.</p>
      </div>

    <% end %>

  </div>

</div>