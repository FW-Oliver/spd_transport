<%= turbo_stream_from "transport_requests_#{current_user.organization_id}" %>

<div class="container">

    <button type="button"
        id="enable-bell"
        class="button">
      🔊 Enable Sound Alerts
    </button>

  <div class="page-header">
<div>
  <%= link_to "Activity Log",
              transporter_activities_path,
              class: "button" %>

  <%= link_to "Information",
              transporter_information_path,
              class: "button" %>
</div>
    <div>
      <p class="location-label">SPD TRANSPORT</p>
      <h1>Transporter Dashboard</h1>
      <p>Today's active transport requests.</p>
    </div>
  </div>

  <% if notice %>
    <div class="notice">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div class="error">
      <%= alert %>
    </div>
  <% end %>

<div class="card">

  <h2>Locations</h2>

  <p>Select the clinic or department you are currently visiting.</p>

  <div class="clinic-button-list">

    <% @locations.each do |location| %>

      <%= link_to location.name,
                  transporter_location_path(location),
                  class: "button button-primary" %>

    <% end %>

  </div>

</div>

<%= render "transporter/requests/requests", requests: @requests %>

  </div>

</div>