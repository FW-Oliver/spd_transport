<div class="container">

  <div class="page-header">
    <div>
      <p class="location-label">SPD TRANSPORT</p>
      <h1>Photo Evidence</h1>
      <p>Transport activity evidence.</p>
    </div>
  </div>

  <div class="card evidence-card">

    <div class="evidence-image-container">
      <%= image_tag rails_blob_path(
            @activity.evidence_photo,
            disposition: "inline"
          ),
          class: "evidence-image",
          alt: "Transport activity evidence" %>
    </div>

    <div class="evidence-details">

      <h2>
        <%= @activity.transporter_action.name %>
      </h2>

      <p>
        <strong>Location:</strong>
        <%= @activity.location.name %>
      </p>

      <p>
        <strong>Time:</strong>
        <%= @activity.performed_at.strftime("%m/%d/%Y %I:%M %p") %>
      </p>

      <p>
        <strong>Transporter:</strong>
        <%= @activity.user.email_address %>
      </p>

    </div>

  </div>

  <div class="card">

    <%= link_to "← Back to Activities",
                transporter_activities_path(
                  date: @selected_date
                ),
                class: "button" %>

  </div>

</div>