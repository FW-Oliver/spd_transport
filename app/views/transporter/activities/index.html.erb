<div class="container">

  <div class="page-header">
    <div>
      <p class="location-label">SPD TRANSPORT</p>
      <h1>SPD Transport Activities</h1>
      <p>Activity history for your organization.</p>
    </div>

    <%= link_to "Back to Dashboard",
                transporter_dashboard_path,
                class: "button" %>
  </div>

  <div class="card activity-date-card">

    <div class="activity-date-navigation">

      <%= link_to "← Previous",
                  transporter_activities_path(
                    date: (@selected_date - 1.day).to_date
                  ),
                  class: "button" %>

      <div class="activity-date-current">
        <strong>
          <%= @selected_date.strftime("%B %-d, %Y") %>
        </strong>

        <% if @selected_date == Date.current %>
          <span class="status status-active">TODAY</span>
        <% end %>
      </div>

      <% if @selected_date < Date.current %>
        <%= link_to "Next →",
                    transporter_activities_path(
                      date: (@selected_date + 1.day).to_date
                    ),
                    class: "button" %>
      <% else %>
        <span class="button button-disabled">
          Next →
        </span>
      <% end %>

    </div>

    <div class="activity-count">
      <strong><%= @activity_count %></strong>
      <span>
        <%= "activity".pluralize(@activity_count) %>
      </span>
    </div>

    <% if @activities.empty? %>

      <div class="empty-state">
        <h3>No activity recorded</h3>
        <p>
          No SPD Transport activities were recorded on
          <%= @selected_date.strftime("%B %-d, %Y") %>.
        </p>
      </div>

    <% else %>

      <div class="activity-log">

        <% @activities.each do |activity| %>

          <div class="activity-log-entry">

            <div class="activity-log-main">

              <div class="activity-log-action">
                <strong>
                  <%= activity.transporter_action.name %>
                </strong>
              </div>

              <div class="activity-log-details">

                <span>
                  <strong>Time:</strong>
                  <%= activity.performed_at.strftime("%I:%M %p") %>
                </span>

                <span>
                  <strong>Transporter:</strong>
                  <%= activity.user.email_address %>
                </span>

                <span>
                  <strong>Location:</strong>
                  <%= activity.location.name %>
                </span>

              </div>

            </div>

            <div class="activity-log-photo">

              <% if activity.evidence_thumbnail.attached? %>

                <%= link_to transporter_activity_path(activity),
                            class: "activity-photo-link" do %>

                  <%= image_tag rails_blob_path(
                        activity.evidence_thumbnail,
                        disposition: "inline"
                      ),
                      class: "activity-photo-thumbnail",
                      alt: "Photo evidence for #{activity.transporter_action.name}" %>

                <% end %>

              <% else %>

                <span class="no-photo">
                  No photo
                </span>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

</div>