<div class="transporter-request" id="transport-request-<%= request.id %>">
  <div>
    <h2><%= request.location.name %></h2>

    <p>
      Requested by:
      <strong><%= request.requested_by_name %></strong>
    </p>

    <p class="request-time">
      <%= request.requested_at.strftime("%I:%M %p") %>
    </p>
  </div>

  <div class="transporter-request-status">
    <% if request.status == "requested" %>

      <span class="status status-requested">
        Requested
      </span>

      <%= button_to "Accept",
                    transporter_accept_request_path(request.id),
                    method: :post,
                    class: "button button-primary" %>

    <% elsif request.status == "accepted" %>

      <span class="status status-accepted">
        Accepted
      </span>

      <%= button_to "Start Transport",
                    transporter_start_transport_path(request.id),
                    method: :post,
                    class: "button button-primary" %>

    <% elsif request.status == "in_transit" %>

      <span class="status status-in-transit">
        In-Transit
      </span>

      <%= button_to "Mark Completed",
                    transporter_complete_request_path(request.id),
                    method: :post,
                    class: "button button-primary" %>

    <% elsif request.status == "completed" %>

      <span class="status status-completed">
        Completed
      </span>

    <% end %>
  </div>
</div>