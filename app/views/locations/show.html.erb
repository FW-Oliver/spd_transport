<div class="container narrow">
  <div class="card location-card">

    <p class="location-label">SPD TRANSPORT</p>

    <h1><%= @location.name %></h1>

    <p class="location-description">
      Request SPD transport for this location.
    </p>

    <% if notice %>
      <div class="notice">
        ✅ <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="error">
        <%= alert %>
      </div>
    <% end %>

    <%= form_with url: request_location_transport_path(@location.qr_token),
                  method: :post do %>

      <div class="form-group">
        <%= label_tag :requested_by_name, "Your name" %>

        <%= text_field_tag :requested_by_name,
                           nil,
                           placeholder: "Enter your name",
                           required: true %>
      </div>

      <%= submit_tag(
            @has_active_requests ?
              "🚚 Request Transport Pick Up Again" :
              "🚚 Request Transport Pick Up",
            class: "button button-primary request-button"
          ) %>

    <% end %>

    <% if @requests.any? %>

      <div class="requests-section">

        <h2>Transport Requests</h2>

        <% @requests.each do |request| %>

          <div class="request-card">

            <div class="request-info">

              <strong>
                <%= request.requested_by_name %>
              </strong>

              <span>
                <%= request.requested_at.strftime("%I:%M %p") %>
              </span>

            </div>

        <div class="request-status">

          <% if request.status == "requested" %>

            <span class="status status-requested">
              Requested
            </span>

          <% elsif request.status == "accepted" %>

            <span class="status status-accepted">
              Accepted
            </span>

          <% elsif request.status == "in_transit" %>

            <span class="status status-in-transit">
              In-Transit
            </span>

          <% elsif request.status == "completed" %>

            <span class="status status-completed">
              Completed
            </span>

          <% elsif request.status == "cancelled" %>

            <span class="status status-cancelled">
              Cancelled
            </span>

          <% end %>

        </div>

            <% if request.cancellable? %>

              <%= button_to "Cancel Request",
                    cancel_location_transport_path(
                      @location.qr_token,
                      request_id: request.id
                    ),
                    method: :post,
                    class: "button button-cancel" %>

            <% end %>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>
</div>