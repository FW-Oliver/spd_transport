<div class="container">
  <div class="page-header">
    <div>
      <p class="location-label">SPD TRANSPORT</p>
      <h1>Welcome</h1>
      <p>How would you like to access SPD Transport?</p>
    </div>
  </div>

  <div class="card">

      <% if flash[:role_error] %>
        <div class="error">
          <%= flash[:role_error] %>
        </div>
      <% end %>
      
    <div class="clinic-button-list">

      <%= link_to "#{ '✓ ' if Current.user&.admin? }I AM ADMIN",
                  role_path("admin"),
                  class: "button button-primary #{'role-selected' if Current.user&.admin?}" %>

      <%= link_to "#{ '✓ ' if Current.user&.viewer? }I AM A VIEWER",
                  role_path("viewer"),
                  class: "button button-primary #{'role-selected' if Current.user&.viewer?}" %>

      <%= link_to "#{ '✓ ' if Current.user&.transporter? }I AM TRANSPORTER FOR TODAY",
                  role_path("transporter"),
                  class: "button button-primary #{'role-selected' if Current.user&.transporter?}" %>
                    
      <%= link_to "I HAVE NO CREDENTIALS",
                  role_path("none"),
                  class: "button" %>

    </div>
  </div>
</div>