<div class="container">

  <h1>SPD Transport Dashboard</h1>

  <p>
    Transport activity for
    <strong><%= current_user.organization.name %></strong>
  </p>

<div class="clinic-buttons">

  <h2>Clinics</h2>

  <div class="clinic-button-list">

    <% @locations.each do |location| %>

      <% active_count = location.transport_requests.active.count %>

      <%= link_to location_path(location.qr_token),
                  class: "button button-primary" do %>

        <%= location.name %>

        <% if active_count > 0 %>
          <span class="request-count">
            <%= active_count %>
          </span>
        <% end %>

      <% end %>

    <% end %>

  </div>

</div>

  <% if @requests.any? %>

    <div class="requests-section">

      <h2>Transport Requests</h2>

      <% @requests.each do |request| %>

        <div class="request-card">

          <div class="request-info">

            <strong>
              <%= request.location.name %>
            </strong>

            <span>
              <%= request.requested_by_name %>
            </span>

            <span>
              <%= request.requested_at.strftime("%I:%M %p") %>
            </span>

          </div>

          <div class="request-status">

            <% if request.status == "requested" %>

              <span class="status status-requested">
                Requested
              </span>

            <% elsif request.status == "accepted" %>

              <span class="status status-accepted">
                Accepted
              </span>

            <% elsif request.status == "in_transit" %>

              <span class="status status-in-transit">
                In-Transit
              </span>

            <% elsif request.status == "completed" %>

              <span class="status status-completed">
                Completed
              </span>

            <% elsif request.status == "cancelled" %>

              <span class="status status-cancelled">
                Cancelled
              </span>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <p>No transport requests yet.</p>

  <% end %>

</div>