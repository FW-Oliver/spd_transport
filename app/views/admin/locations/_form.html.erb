<%= form_with model: [:admin, location] do |form| %>

  <% if location.errors.any? %>
    <div class="error">
      <h3><%= pluralize(location.errors.count, "error") %> prevented this location from being saved:</h3>

      <ul>
        <% location.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Location name" %>
    <%= form.text_field :name,
                        placeholder: "Example: OR 4",
                        autofocus: true %>
  </div>

  <div class="form-group checkbox">
    <%= form.check_box :active %>
    <%= form.label :active, "Active" %>
  </div>

  <div class="form-actions">
    <%= form.submit location.new_record? ? "Create Location" : "Save Changes",
                    class: "button button-primary" %>

    <%= link_to "Cancel", admin_locations_path, class: "button" %>
  </div>

<% end %>