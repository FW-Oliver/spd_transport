<div class="container">

  <div class="page-header">
    <div>
      <p class="location-label">SPD TRANSPORT</p>
      <h1><%= @information_page.title %></h1>

      <% if @information_page.published? %>
        <span class="status status-completed">Published</span>
      <% else %>
        <span class="status status-requested">Draft</span>
      <% end %>
    </div>

    <div>
      <%= link_to "Edit",
                  edit_admin_information_page_path(@information_page),
                  class: "button button-primary" %>

      <%= button_to(
            @information_page.published? ? "Unpublish" : "Publish",
            toggle_publish_admin_information_page_path(@information_page),
            method: :post,
            class: "button"
          ) %>

      <%= link_to "Back",
                  admin_information_pages_path,
                  class: "button" %>
    </div>
  </div>

  <div class="card">

    <p class="request-time">
      Last updated:
      <%= @information_page.updated_at.strftime("%b %-d, %Y %I:%M %p") %>
    </p>

    <hr>

    <h2>Content</h2>

    <div class="information-page-content">
      <%= render_markdown(@information_page.content) %>
    </div>

  </div>

</div>